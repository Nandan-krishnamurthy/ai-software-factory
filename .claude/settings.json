{
  "permissions": {
    "allow": [
      "Bash(git -C:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr list:*)",
      "Bash(python scripts/factory.py:*)"
    ],
    "deny": [
      "Bash(gh pr merge:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh secret:*)",
      "Bash(gh alias:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --mirror:*)",
      "Bash(git push origin main)",
      "Bash(git push origin HEAD:main)",
      "Bash(git push -u origin main)",
      "PowerShell(gh pr merge:*)",
      "PowerShell(gh pr review:*)",
      "PowerShell(gh pr comment:*)",
      "PowerShell(gh issue comment:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/scripts/factory.py\" guard",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
